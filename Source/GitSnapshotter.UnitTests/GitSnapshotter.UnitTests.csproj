<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net11.0;net472</TargetFrameworks>
        <LangVersion>latest</LangVersion>
        <!-- No Polyfill here: the library's polyfills are internal and visible through InternalsVisibleTo. -->
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="AutoFixture" />
        <PackageReference Include="TUnit.Assertions" />
        <PackageReference Include="TUnit.Engine" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="TUnit.Assertions.Enums" />
    </ItemGroup>

    <!--
      .NET Framework tests can only run on Windows. Elsewhere the net472 build still compiles (so the lock file is
      the same on every OS), but dotnet test leaves it out.
    -->
    <!--
      A .NET Framework test app gets a runtime identifier picked by the SDK on Windows (win-x86), which the restored
      packages don't cover. Set it explicitly, on every OS, so restore and the lock file include it.
    -->
    <PropertyGroup Condition="'$(TargetFramework)' == 'net472'">
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    </PropertyGroup>
    <PropertyGroup Condition="'$(TargetFramework)' == 'net472' and !$([MSBuild]::IsOSPlatform('Windows'))">
        <IsTestProject>false</IsTestProject>
        <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
        <OutputType>Library</OutputType>
    </PropertyGroup>
    <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
        <Using Remove="System.Net.Http" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\GitSnapshotter\GitSnapshotter.csproj" />
      <ProjectReference Include="..\Constants\Constants.csproj" />
    </ItemGroup>

    <!-- The console app targets .NET 11 only, so its tests run on that framework only. -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
      <ProjectReference Include="..\GitSnapshotter.Console\GitSnapshotter.Console.csproj" />
    </ItemGroup>
    <ItemGroup Condition="'$(TargetFramework)' != 'net11.0'">
      <Compile Remove="CliTests.cs" />
    </ItemGroup>

</Project>
