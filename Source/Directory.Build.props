<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- Shared by the packages built from Source: the GitSnapshotter library and the GitSnapshotter.Tool .NET tool. -->
  <PropertyGroup>
    <!-- Release builds override this with the tag's version (Build:Version in the pipeline). -->
    <VersionPrefix>0.1.0</VersionPrefix>
    <Authors>BusHero</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/BusHero/GitSnapshotter.git</RepositoryUrl>
  </PropertyGroup>
</Project>
