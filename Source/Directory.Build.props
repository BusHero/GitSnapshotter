<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- Shared by the packages built from Source: the GitSnapshotter library and the GitSnapshotter.Tool .NET tool. -->
  <PropertyGroup>
    <!-- The version being worked towards: builds from branches are <VersionPrefix>-<branch>-<time>, and release
         builds override it with the release version (Build:Version in the pipeline). Raise it after each stable
         release, so branch builds sort above what is already released. -->
    <VersionPrefix>0.2.0</VersionPrefix>
    <Authors>BusHero</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/BusHero/GitSnapshotter.git</RepositoryUrl>
    <!-- SourceLink (built into the SDK): record the repository in the package and embed generated sources. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <!-- A .snupkg symbol package next to each .nupkg; nuget.org serves it to debuggers. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
</Project>
