<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- Shared by the packages built from Source: the GitSnapshotter library and the GitSnapshotter.Tool .NET tool. -->
  <PropertyGroup>
    <!-- The version being worked towards. Builds take the next release after the tagged ones: this, unless a stable
         release at or above it is tagged, then the patch after the newest release; plus the run number as build
         metadata (0.4.1+57, see pipeline/GitSnapshotter.Pipeline/PackageVersion.cs). Raise it only to start a new
         minor or major version, or a prerelease (0.5.0-rc.1), which has to be raised again once released. -->
    <VersionPrefix>0.4.0</VersionPrefix>
    <Authors>BusHero</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/BusHero/GitSnapshotter.git</RepositoryUrl>
    <!-- SourceLink (built into the SDK): record the repository in the package and embed generated sources. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <!-- A .snupkg symbol package next to each .nupkg; nuget.org serves it to debuggers. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
</Project>
