<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net472</TargetFrameworks>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>GitSnapshotter</PackageId>
        <VersionPrefix>0.1.0</VersionPrefix>
        <Authors>BusHero</Authors>
        <Description>Take a snapshot of a git repository's branches, tags, remotes, HEAD and (optionally) working tree, and restore it later.</Description>
        <PackageTags>git;snapshot;restore;libgit2sharp;testing</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
        <RepositoryUrl>https://github.com/BusHero/GitSnapshotter.git</RepositoryUrl>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="LibGit2Sharp" />
    </ItemGroup>
    <!-- .NET Framework needs polyfills for newer C# and BCL features, and System.Text.Json as a package. -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
      <PackageReference Include="Polyfill">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
      <PackageReference Include="System.Text.Json" />
      <Using Remove="System.Net.Http" />
    </ItemGroup>
    <ItemGroup>
        <None Include="docs\README.md" Pack="true" PackagePath="\"/>
        <None Include="..\..\assets\logo\icon.png" Pack="true" PackagePath="\" Visible="false"/>
        <!-- Generated by the build pipeline (ThirdPartyNoticesModule), which passes its path to pack. -->
        <None Include="$(ThirdPartyNoticesFile)" Pack="true" PackagePath="\" Visible="false"
              Condition="'$(ThirdPartyNoticesFile)' != ''"/>
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="GitSnapshotter.UnitTests" />
    </ItemGroup>
</Project>
