    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>GitSnapshotter.Console</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GitSnapshotter.UnitTests" />
  </ItemGroup>

</Project>
