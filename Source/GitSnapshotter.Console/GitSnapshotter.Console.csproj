<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\GitSnapshotter\GitSnapshotter.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- .NET 8 is the oldest supported runtime; the .NET 11 build is used where .NET 11 or later is installed. -->
    <TargetFrameworks>net8.0;net11.0</TargetFrameworks>
    <!-- Not a library: no XML docs required on public members. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <RootNamespace>GitSnapshotter.Console</RootNamespace>
    <!-- Run on newer runtimes too: the net8.0 build serves .NET 8, 9 and 10, and any later runtime without its own build. -->
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <!-- Packed as a .NET tool: dotnet tool install -g GitSnapshotter.Tool, then run gitsnapshotter. -->
  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>gitsnapshotter</ToolCommandName>
    <PackageId>GitSnapshotter.Tool</PackageId>
    <Authors>BusHero</Authors>
    <Description>Command-line tool that takes a snapshot of a git repository's branches, tags, remotes, HEAD and (optionally) working tree, and restores it later.</Description>
    <PackageTags>git;snapshot;restore;cli;dotnet-tool</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <RepositoryUrl>https://github.com/BusHero/GitSnapshotter.git</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Include="docs\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\logo\icon.png" Pack="true" PackagePath="\" Visible="false" />
    <!-- Generated by the build pipeline (ThirdPartyNoticesModule), which passes its path to pack. -->
    <None Include="$(ThirdPartyNoticesFile)" Pack="true" PackagePath="\" Visible="false"
          Condition="'$(ThirdPartyNoticesFile)' != ''" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GitSnapshotter.UnitTests" />
  </ItemGroup>

</Project>
