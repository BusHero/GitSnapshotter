<Project>
  <!-- Central Package Management: every package version is set here, and projects reference packages without a version. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Library">
    <PackageVersion Include="LibGit2Sharp" Version="0.32.0" />
    <PackageVersion Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" />
    <!-- Source-only polyfills for newer C# and BCL features on .NET Framework. -->
    <PackageVersion Include="Polyfill" Version="11.4.5" />
    <PackageVersion Include="System.Text.Json" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="AutoFixture" Version="4.18.1" />
    <PackageVersion Include="TUnit.Assertions" Version="1.84.0" />
    <PackageVersion Include="TUnit.Engine" Version="1.84.0" />
  </ItemGroup>

  <ItemGroup Label="Pipeline">
    <PackageVersion Include="ModularPipelines" Version="3.2.8" />
    <PackageVersion Include="ModularPipelines.DotNet" Version="3.2.8" />
    <PackageVersion Include="ModularPipelines.Git" Version="3.2.8" />
  </ItemGroup>
</Project>
